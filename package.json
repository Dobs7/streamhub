{
  "name": "streamhub",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "package:win": "pnpm build && electron-builder --win portable",
    "build:tv": "vite build --mode tv && node scripts/prepare-tv.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.streamhub.desktop",
    "productName": "StreamHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "core/**/*",
      "tv/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "artifactName": "StreamHub-${version}-Windows.${ext}"
    },
    "copyright": "Copyright © 2026 Dobs by Azura. Créditos de terceiros preservados."
  },
  "description": "Descoberta de filmes e series com catalogo TMDB e interface Windows e TV",
  "author": "Dobs by Azura"
}
